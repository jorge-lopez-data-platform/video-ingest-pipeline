{
  "job_id": 813880207704409,
  "new_settings": {
    "description": "Produccion diaria de TikTok: guiones virales (opcionalmente con Apify), video animado con subtitulos y envio al inbox como borrador. La cantidad y la tematica se eligen con los parametros `cantidad` y `hashtags`. Publicacion directa deshabilitada: la app no esta auditada por TikTok.",
    "email_notifications": {
      "no_alert_for_skipped_runs": false
    },
    "environments": [
      {
        "environment_key": "publish",
        "spec": {
          "client": "3"
        }
      },
      {
        "environment_key": "video",
        "spec": {
          "client": "3",
          "dependencies": [
            "pillow==10.3.0",
            "edge-tts==7.3.1",
            "imageio-ffmpeg",
            "anthropic"
          ]
        }
      }
    ],
    "format": "MULTI_TASK",
    "max_concurrent_runs": 1,
    "name": "tiktok_produccion_diaria",
    "parameters": [
      {
        "default": "true",
        "name": "allow_resubmit"
      },
      {
        "default": "2",
        "name": "cantidad"
      },
      {
        "default": "",
        "name": "excluir_ids"
      },
      {
        "default": "superacionpersonal,emociones,sentimientos,depresion,ganasdevivir,saludmental,tristeza,vivir,autoestima,ansiedad,resiliencia,soledad,reflexion,motivacion",
        "name": "hashtags"
      },
      {
        "default": "claude-haiku-5-5",
        "name": "llm_model"
      },
      {
        "default": "@alguienqueteescucha",
        "name": "marca_usuario"
      },
      {
        "default": "0.5",
        "name": "max_charge_usd"
      },
      {
        "default": "2",
        "name": "max_pendientes"
      },
      {
        "default": "8000",
        "name": "max_tokens_por_peticion"
      },
      {
        "default": "15000",
        "name": "min_likes"
      },
      {
        "default": "5",
        "name": "n_hashtags"
      },
      {
        "default": "motivacional",
        "name": "personaje"
      },
      {
        "default": "+8%",
        "name": "rate"
      },
      {
        "default": "25",
        "name": "results_per_hashtag"
      },
      {
        "default": "12",
        "name": "top_n"
      },
      {
        "default": "true",
        "name": "usar_apify"
      },
      {
        "default": "",
        "name": "video_fuente_id"
      },
      {
        "default": "es-MX-JorgeNeural",
        "name": "voz"
      },
      {
        "default": "5",
        "name": "guiones_objetivo"
      },
      {
        "default": "12",
        "name": "max_llamadas_llm"
      },
      {
        "default": "14",
        "name": "max_age_days"
      },
      {
        "default": "1000000",
        "name": "min_plays"
      },
      {
        "default": "5",
        "name": "hashtags_por_corrida"
      }
    ],
    "performance_target": "PERFORMANCE_OPTIMIZED",
    "queue": {
      "enabled": true
    },
    "tags": {
      "content": "own",
      "project": "tiktok",
      "stage": "production"
    },
    "tasks": [
      {
        "disabled": false,
        "email_notifications": {},
        "notebook_task": {
          "base_parameters": {
            "guiones_objetivo": "{{job.parameters.guiones_objetivo}}",
            "hashtags": "{{job.parameters.hashtags}}",
            "hashtags_por_corrida": "{{job.parameters.hashtags_por_corrida}}",
            "llm_model": "{{job.parameters.llm_model}}",
            "max_age_days": "{{job.parameters.max_age_days}}",
            "max_charge_usd": "{{job.parameters.max_charge_usd}}",
            "max_duration_sec": "60",
            "max_llamadas_llm": "{{job.parameters.max_llamadas_llm}}",
            "max_tokens_por_peticion": "{{job.parameters.max_tokens_por_peticion}}",
            "min_likes": "{{job.parameters.min_likes}}",
            "min_plays": "{{job.parameters.min_plays}}",
            "results_per_hashtag": "{{job.parameters.results_per_hashtag}}",
            "top_n": "{{job.parameters.top_n}}",
            "usar_apify": "{{job.parameters.usar_apify}}"
          },
          "notebook_path": "/Workspace/Users/USUARIO/tiktok_ingest/guiones_60s_viral",
          "source": "WORKSPACE"
        },
        "run_if": "ALL_SUCCESS",
        "task_key": "guiones_60s",
        "timeout_seconds": 3600
      },
      {
        "depends_on": [
          {
            "task_key": "guiones_60s"
          }
        ],
        "disabled": false,
        "email_notifications": {},
        "environment_key": "video",
        "notebook_task": {
          "base_parameters": {
            "cantidad": "{{job.parameters.cantidad}}",
            "dry_run": "false",
            "excluir_ids": "{{job.parameters.excluir_ids}}",
            "marca_usuario": "{{job.parameters.marca_usuario}}",
            "n_hashtags": "{{job.parameters.n_hashtags}}",
            "personaje": "{{job.parameters.personaje}}",
            "rate": "{{job.parameters.rate}}",
            "temas_hashtags": "{{job.parameters.hashtags}}",
            "video_fuente_id": "{{job.parameters.video_fuente_id}}",
            "voz": "{{job.parameters.voz}}"
          },
          "notebook_path": "/Workspace/Users/USUARIO/tiktok_ingest/generar_video_guion",
          "source": "WORKSPACE"
        },
        "run_if": "ALL_SUCCESS",
        "task_key": "generar_video",
        "timeout_seconds": 7200
      },
      {
        "depends_on": [
          {
            "task_key": "generar_video"
          }
        ],
        "disabled": false,
        "email_notifications": {},
        "for_each_task": {
          "inputs": "{{tasks.generar_video.values.videos}}",
          "task": {
            "disabled": false,
            "email_notifications": {},
            "environment_key": "publish",
            "notebook_task": {
              "base_parameters": {
                "publicar": "true",
                "video_name": "{{input.video_name}}"
              },
              "notebook_path": "/Users/USUARIO/tiktok_ingest/publicar_facebook",
              "source": "WORKSPACE"
            },
            "run_if": "ALL_SUCCESS",
            "task_key": "publicar_facebook_item",
            "timeout_seconds": 1500
          }
        },
        "run_if": "ALL_DONE",
        "task_key": "publicar_facebook",
        "timeout_seconds": 0
      },
      {
        "depends_on": [
          {
            "task_key": "generar_video"
          }
        ],
        "disabled": false,
        "email_notifications": {},
        "for_each_task": {
          "inputs": "{{tasks.generar_video.values.videos}}",
          "task": {
            "disabled": false,
            "email_notifications": {},
            "environment_key": "publish",
            "notebook_task": {
              "base_parameters": {
                "privacy": "public",
                "video_name": "{{input.video_name}}"
              },
              "notebook_path": "/Users/USUARIO/tiktok_ingest/publicar_youtube",
              "source": "WORKSPACE"
            },
            "run_if": "ALL_SUCCESS",
            "task_key": "publicar_youtube_item",
            "timeout_seconds": 1500
          }
        },
        "run_if": "ALL_DONE",
        "task_key": "publicar_youtube",
        "timeout_seconds": 0
      },
      {
        "depends_on": [
          {
            "task_key": "generar_video"
          }
        ],
        "disabled": false,
        "email_notifications": {},
        "environment_key": "publish",
        "notebook_task": {
          "base_parameters": {
            "allow_resubmit": "{{job.parameters.allow_resubmit}}",
            "max_pendientes": "{{job.parameters.max_pendientes}}"
          },
          "notebook_path": "/Workspace/Users/USUARIO/tiktok_ingest/subir_cola",
          "source": "WORKSPACE"
        },
        "run_if": "ALL_SUCCESS",
        "task_key": "subir_borradores",
        "timeout_seconds": 5400
      },
      {
        "depends_on": [
          {
            "task_key": "subir_borradores"
          },
          {
            "task_key": "publicar_youtube"
          },
          {
            "task_key": "publicar_facebook"
          }
        ],
        "disabled": false,
        "email_notifications": {},
        "environment_key": "publish",
        "notebook_task": {
          "notebook_path": "/Workspace/Users/USUARIO/tiktok_ingest/cerrar_distribucion",
          "source": "WORKSPACE"
        },
        "run_if": "ALL_DONE",
        "task_key": "cerrar_distribucion",
        "timeout_seconds": 900
      }
    ],
    "timeout_seconds": 0,
    "triggers": [
      {
        "pause_status": "UNPAUSED",
        "schedule": {
          "quartz_cron_expression": "0 0 6,15,23 * * ?",
          "timezone_id": "America/Merida"
        }
      }
    ]
  }
}
