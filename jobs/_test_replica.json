{
 "name": "prueba_replica",
 "parameters": [
  {
   "name": "dry_run",
   "default": "false"
  }
 ],
 "environments": [
  {
   "environment_key": "video",
   "spec": {
    "client": "3",
    "dependencies": [
     "pillow==10.3.0"
    ]
   }
  }
 ],
 "tasks": [
  {
   "task_key": "productor",
   "environment_key": "video",
   "notebook_task": {
    "notebook_path": "/Users/lopezechagarayjorge@gmail.com/tiktok_ingest/_tmp/_eco_pub3"
   }
  },
  {
   "task_key": "consumidor",
   "depends_on": [
    {
     "task_key": "productor"
    }
   ],
   "for_each_task": {
    "inputs": "{{tasks.productor.values.ids}}",
    "concurrency": 3,
    "task": {
     "task_key": "hijo",
     "max_retries": 1,
     "environment_key": "video",
     "notebook_task": {
      "notebook_path": "/Users/lopezechagarayjorge@gmail.com/tiktok_ingest/_tmp/_eco4",
      "base_parameters": {
       "manifiesto": "{{tasks.productor.values.manifiesto}}",
       "valor": "{{input}}",
       "dry_run": "{{job.parameters.dry_run}}"
      }
     },
     "timeout_seconds": 600
    }
   }
  }
 ]
}